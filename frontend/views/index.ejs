<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whitepace</title>

    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%- include('header') %>
        <main class="main">
            <section class="hero">
                <div class="wrapper">
                    <div class="hero-wrapper">
                        <div class="hero-title-wrapper">
                            <h1 class="hero-title">Get More Done with whitepace</h1>
                            <p class="hero-subtitle section-subtitle">Project management software that enables your
                                teams to collaborate,
                                plan, analyze and manage everyday tasks</p>
                            <a href="#" class="try-btn  btn btn-radius">
                                Try Whitepace free &DDotrahd;
                            </a>
                        </div>
                        <img src="../img/hero-foto.jpeg" alt="" class="hero-foto">
                    </div>
                </div>
            </section>
            <!-- hero end  -->


            <!-- management start -->
            <section class="management">
                <div class="wrapper">
                    <div class="managment-wrapper">
                        <div class="managment-title-wrapper">
                            <h1 class="section-title">Get More Done with whitepace</h1>
                            <p class="managment-subtitle section-subtitle">Images, videos, PDFs and audio files are
                                supported. Create
                                math expressions and diagrams directly from the app. Take photos with the mobile app and
                                save them to a note.</p>
                            <a href="#" class="try-btn  btn btn-radius">
                                Get Started &DDotrahd;
                            </a>
                        </div>
                        <!-- <div class="managment-foto-wrapper"> -->
                        <img src="../img/hero-foto.jpeg" alt="" class="managment-foto">
                        <!-- </div> -->
                    </div>
            </section>
            <!-- management end -->

            <!-- work start -->
            <section class="work">
                <div class="wrapper">
                    <div class="work-wrapper">
                        <img src="../img/work-img.jpg" alt="" class="work-foto">
                        <div class="work-title-wrapper">
                            <h1 class="section-title">Work together</h1>
                            <p class="work-subtitle section-subtitle">With whitepace, share your notes with your
                                colleagues and
                                collaborate on them.
                                You can also publish a note to the internet and share the URL with others.
                            </p>
                            <a href="#" class="try-btn  btn btn-radius">
                                Get Started &DDotrahd;
                            </a>
                        </div>

                    </div>
            </section>
            <!-- work end -->

            <!-- customise start -->
            <section class="customise">
                <div class="wrapper">
                    <div class="customise-wrapper">
                        <div class="customise-title-wrapper">
                            <h1 class="section-title">Customise it
                                to
                                your needs</h1>
                            <p class="customise-subtitle section-subtitle">Customise the app with plugins, custom themes
                                and multiple
                                text editors (Rich Text or Markdown). Or create your own scripts and plugins using the
                                Extension API.
                            </p>
                            <a href="#" class="try-btn  btn btn-radius">
                                Get Started &DDotrahd;
                            </a>
                        </div>

                        <img src="../img/hero-foto.jpeg" alt="" class="customise-foto">
                    </div>
                </div>
            </section>
            <!-- customise end -->

            <!-- plan start -->
            <section class="plan">
                <div class="wrapper">
                    <div class="plan-wrapper">
                        <h1 class="section-title-last section-title">
                            Choose Your Plan
                            s</h1>
                        <p class="plan-subtitle section-subtitle">Customise the app with plugins, custom themes and
                            multiple
                            text editors (Rich Text or Markdown). Or create your own scripts and plugins using the
                            Extension API.
                        </p>
                    </div>

                    <div class="plans-columns-wrapper">
                        <div class="plan-column col1 btn-radius">
                            <div class="plan-title">Free</div>
                            <div class="plan-cost">$0</div>
                            <div class="plan-columns-subtitle">Capture ideas and find them quickly</div>

                            <ul class="plan-features">
                                <li class="plan-feature">
                                    Sync unlimited devices
                                </li>
                                <li class="plan-feature">
                                    10 GB monthly uploads
                                </li>
                                <li class="plan-feature">
                                    200 MB max. note size
                                </li>
                                <li class="plan-feature">
                                    Customize Home dashboard and access extra widgets
                                </li>
                                <li class="plan-feature">
                                    Connect primary Google Calendar account
                                </li>
                                <li class="plan-feature">
                                    Add due dates, reminders, and notifications to your tasks
                                </li>

                            </ul>
                            <div class="plan-button btn-radius">Get Started</div>
                        </div>
                        <div class="plan-column col2 btn-radius">
                            <div class="plan-title">Personal</div>
                            <div class="plan-cost">$11.99</div>
                            <div class="plan-columns-subtitle">Keep home and family on track</div>

                            <ul class="plan-features">
                                <li class="plan-feature plan-feature-personal">
                                    Sync unlimited devices
                                </li>
                                <li class="plan-feature">
                                    10 GB monthly uploads
                                </li>
                                <li class="plan-feature">
                                    200 MB max. note size
                                </li>
                                <li class="plan-feature">
                                    Customize Home dashboard and access extra widgets
                                </li>
                                <li class="plan-feature">
                                    Add due dates, reminders, and notifications to your tasks

                                </li>
                                <li class="plan-feature">
                                    Add due dates, reminders, and notifications to your tasks
                                </li>

                            </ul>
                            <div class="plan-button-personal btn-radius">Get Started</div>
                        </div>
                        <div class="plan-column col1 btn-radius">
                            <div class="plan-title">Organization</div>
                            <div class="plan-cost">$49.99</div>
                            <div class="plan-columns-subtitle">Capture ideas and find them quickly</div>

                            <ul class="plan-features">
                                <li class="plan-feature">
                                    Sync unlimited devices
                                </li>
                                <li class="plan-feature">
                                    10 GB monthly uploads
                                </li>
                                <li class="plan-feature">
                                    200 MB max. note size
                                </li>
                                <li class="plan-feature">
                                    Customize Home dashboard and access extra widgets
                                </li>
                                <li class="plan-feature">
                                    Connect primary Google Calendar account
                                </li>
                                <li class="plan-feature">
                                    Add due dates, reminders, and notifications to your tasks
                                </li>

                            </ul>
                            <div class="plan-button btn-radius">Get Started</div>
                        </div>
                    </div>
                </div>



            </section>
            <!-- plan end -->

        </main>

        <script src="../js/main.js"></script>

        <%- include('footer') %>
</body>

</html>